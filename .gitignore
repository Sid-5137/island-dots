# Generated by matugen on every wallpaper change. It lives in
# ~/.local/state/island now, not in here — this entry only catches
# leftovers from an install that predates the move.
quickshell/island/colors.json

# Generated by install.sh from matugen/config.toml.in with this
# machine's absolute paths filled in.
matugen/config.toml

# Machine state, not configuration. Written on first run from the
# defaults in Services/Config.qml.
settings.json

# Backups from swapping the tree around
*.bak
*.orig
*~

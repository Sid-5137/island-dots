# Generated by matugen on every wallpaper change. Services/Theme.qml
# falls back to sane defaults when it's absent, so a fresh clone works
# without it — and tracking it would mean a diff on every wallpaper.
quickshell/island/colors.json

# Machine state, not configuration. Written on first run from the
# defaults in Services/Config.qml.
settings.json

# Backups from swapping the tree around
*.bak
*.orig
*~

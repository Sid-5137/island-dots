#%PAM-1.0
#
# island — lock screen authentication.
#
# Generated by install.sh from pam/island.in. @STACK@ is filled in with
# whichever system stack this distribution uses:
#
#   password-auth   Fedora, RHEL, openSUSE
#   system-auth     Arch
#   common-auth     Debian, Ubuntu
#
# Config.island.pamConfig selects this file by name, so the lock screen
# authenticates against /etc/pam.d/island rather than /etc/pam.d/login.
#
# Why a dedicated file rather than reusing login:
#
#   Adding pam_fprintd to /etc/pam.d/login enables the fingerprint
#   reader for tty logins too, where there is no prompt telling you to
#   touch it and a failed read looks like a hung terminal. Keeping it
#   here means the reader works at the lock screen and nowhere else.
#
# The fingerprint line is first and non-fatal: on success it finishes
# the stack, and on failure — or on a machine with no reader at all —
# it is ignored and the password stack below runs as normal. Removing
# pam_fprintd entirely leaves a working password-only lock.

auth        [success=done default=ignore]   pam_fprintd.so
auth        include         @STACK@

account     include         @STACK@
password    include         @STACK@
session     include         @STACK@

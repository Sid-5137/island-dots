#!/usr/bin/env python3
"""Continuous four-finger gestures for the island.

Hyprland's `gesture` action fires once, on release. Its own workspace
swipe is continuous because it is implemented inside the compositor,
and that progress is not exposed to custom gestures.

libinput emits the underlying events regardless, so this reads them
directly and streams deltas to the shell over a unix socket. An earlier
version called `qs ipc call` per step: that spawns a process, connects
and exits, which caps the rate at roughly one step every 20ms. One open
socket removes the spawn, so the value can follow the fingers frame by
frame.

Requires membership of the `input` group:

    sudo usermod -aG input "$USER"
"""

import os
import re
import shutil
import socket
import subprocess
import sys
import time

# Finger travel per unit of change. Small, because there is no longer a
# process spawn to amortise — this is what "1 percent control" costs.
STEP_PX = 8

# A swipe is never purely vertical. The dominant axis is chosen once
# per gesture and held, or a slightly diagonal drag alternates between
# volume and brightness.
AXIS_LOCK_RATIO = 1.3
AXIS_LOCK_MIN = 8.0

SOCKET_PATH = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "island-gestures.sock")

BEGIN = re.compile(r"GESTURE_SWIPE_BEGIN.*?\s(\d+)\s*$")
UPDATE = re.compile(r"GESTURE_SWIPE_UPDATE\s.*?\s(\d+)\s+([-\d.]+)/\s*([-\d.]+)")
END = re.compile(r"GESTURE_SWIPE_END")


class Shell:
    """One socket to the shell, reconnected if it restarts."""

    def __init__(self, path):
        self.path = path
        self.sock = None

    def connect(self):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(self.path)
            self.sock = s
            return True
        except OSError:
            self.sock = None
            return False

    def send(self, line):
        if self.sock is None and not self.connect():
            return
        try:
            self.sock.sendall((line + "\n").encode())
        except OSError:
            # The shell was restarted; try once more next event.
            self.sock = None


def main():
    if not shutil.which("libinput"):
        sys.exit("libinput not found — install libinput-utils")

    shell = Shell(SOCKET_PATH)

    # The shell may not be up yet at login.
    for _ in range(20):
        if shell.connect():
            break
        time.sleep(0.5)

    proc = subprocess.Popen(
        ["libinput", "debug-events"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    fingers = 0
    ax = ay = 0.0
    axis = None

    for line in proc.stdout:
        if (m := BEGIN.search(line)):
            fingers = int(m.group(1))
            ax = ay = 0.0
            axis = None
            continue

        if END.search(line):
            fingers = 0
            axis = None
            continue

        if fingers != 4:
            continue

        if not (m := UPDATE.search(line)):
            continue

        ax += float(m.group(2))
        ay += float(m.group(3))

        if axis is None:
            if abs(ay) > abs(ax) * AXIS_LOCK_RATIO and abs(ay) > AXIS_LOCK_MIN:
                axis = "v"
            elif abs(ax) > abs(ay) * AXIS_LOCK_RATIO and abs(ax) > AXIS_LOCK_MIN:
                axis = "h"
            else:
                continue

        # Whole steps are sent and the remainder carried, so slow
        # movement still accumulates rather than being rounded away.
        if axis == "v":
            steps = int(-ay / STEP_PX)
            if steps:
                ay += steps * STEP_PX
                shell.send(f"v {steps}")
        else:
            steps = int(ax / STEP_PX)
            if steps:
                ax -= steps * STEP_PX
                shell.send(f"b {steps}")

    return proc.wait()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)

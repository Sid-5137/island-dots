# Generated by matugen — do not edit.
# -> ~/.local/share/color-schemes/Island.colors
#
# KColorScheme's format, which is what KF6 applications read. They do
# not go through QT_QPA_PLATFORMTHEME and so never see qt6ct's
# palette — a KDE app on a GNOME or Hyprland desktop reads kdeglobals
# directly and nothing else.
#
# A file here only makes the scheme *selectable*. What applies it is
# the same colours copied into ~/.config/kdeglobals, which is the
# contested file: it also holds the widget style and the icon theme,
# neither of which is matugen's to overwrite. bin/island-qt-apply
# merges this into it group by group, the way island-gtk-apply owns
# gtk.css and imports matugen.css.
#
# Colours are r,g,b decimal triples, not hex. That is KConfig's
# format, not a preference.

[General]
ColorScheme=Island
Name=Island
shadeSortColumn=true

[Colors:Window]
BackgroundNormal={{colors.surface.dark.red}},{{colors.surface.dark.green}},{{colors.surface.dark.blue}}
BackgroundAlternate={{colors.surface_container.dark.red}},{{colors.surface_container.dark.green}},{{colors.surface_container.dark.blue}}
DecorationFocus={{colors.primary.dark.red}},{{colors.primary.dark.green}},{{colors.primary.dark.blue}}

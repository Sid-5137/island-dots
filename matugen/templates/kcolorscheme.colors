# The window manager's own colours. Hyprland does not read these, but
# a KDE application drawing its own titlebar under a portal does.
[WM]
activeBackground={{colors.surface_container.dark.red}},{{colors.surface_container.dark.green}},{{colors.surface_container.dark.blue}}
activeForeground={{colors.on_surface.dark.red}},{{colors.on_surface.dark.green}},{{colors.on_surface.dark.blue}}
activeBlend={{colors.primary.dark.red}},{{colors.primary.dark.green}},{{colors.primary.dark.blue}}
inactiveBackground={{colors.surface.dark.red}},{{colors.surface.dark.green}},{{colors.surface.dark.blue}}
inactiveForeground={{colors.on_surface_variant.dark.red}},{{colors.on_surface_variant.dark.green}},{{colors.on_surface_variant.dark.blue}}
inactiveBlend={{colors.outline.dark.red}},{{colors.outline.dark.green}},{{colors.outline.dark.blue}}

# How KColorScheme derives the states it is not given. These are
# Breeze's own numbers: they are a description of what "greyed out"
# and "unfocused" mean, not of any particular palette, so they do not
# come from the wallpaper.
[ColorEffects:Disabled]
ChangeSelectionColor=true
Color={{colors.surface_container_high.dark.red}},{{colors.surface_container_high.dark.green}},{{colors.surface_container_high.dark.blue}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{colors.surface_container_high.dark.red}},{{colors.surface_container_high.dark.green}},{{colors.surface_container_high.dark.blue}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
IntensityAmount=0
IntensityEffect=0
